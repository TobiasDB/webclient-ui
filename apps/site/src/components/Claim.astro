---
/** A feature page's one-line claim + the proof stamp: every claim sits next to the code that proves it. */
interface Props { claim: string; proof: string }
const { claim, proof } = Astro.props;
---
<div class="mx-auto max-w-[1100px] px-5 pt-12">
  <p class="max-w-[820px] text-[28px] font-semibold leading-tight tracking-tight">{claim}</p>
  <p class="mt-3 font-mono text-[12px] text-muted">proof: {proof}</p>
</div>

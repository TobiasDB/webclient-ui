---
/** the `iframe` fixture (the table of contents is an embedded document) + the PDF */
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { TITLES } from "../data/lab";
---
<Base title={TITLES.whitepaper}>
  <Section kicker="the idea, in writing" title="Whitepaper">
    <main>
      <h1 class="sr-only">Whitepaper</h1>
      <p class="mb-4 max-w-[760px] text-[14px] leading-6 text-muted">"One plan, many runners": why a query should be data. Download the <a class="text-accent" href="/whitepaper.pdf">PDF</a>. The contents below are an embedded document (an iframe — the client flags it and a browser tier reads inside).</p>
      <iframe src="/embed/toc" title="contents" class="h-40 w-full max-w-[520px] rounded-md border border-line"></iframe>
    </main>
  </Section>
</Base>

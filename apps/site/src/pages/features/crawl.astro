---
import Feature from "../../layouts/Feature.astro";
import Code from "../../components/Code.astro";
import { LiveDemo } from "../../islands/LiveDemo";
const CRAWL = `with WebClient() as wc:
    with wc.crawl("${Astro.url.origin}/", auto=True, max_pages=8, browser=False) as crawl:
        crawl.run()                       # scored frontier, robots honoured, resources dropped
    [p.final_url for p in crawl.pages]
    [f.reason for f in crawl.failures]    # e.g. "robots-disallowed" for /login

    found = wc.locate("${Astro.url.origin}/", until=lambda c: "Whitepaper" in (c.title or ""),
                      max_pages=6)         # a crawl with a goal: stops at the page you described`;
---
<Feature slug="crawl" next={["/features/onboarding", "/features/traces", "/sitemap.xml"]}>
  <p class="mb-4 max-w-[820px] text-[15px] leading-7 text-muted">A crawl is a bounded loop: observe the frontier, score it, pick, fetch, repeat — with a budget, a scope, and robots.txt. <code>locate</code> is the same loop with a stop condition. This site publishes a sitemap and disallows <code>/login</code>, <code>/account</code> and <code>/blocked</code>; the crawl reads both.</p>
  <div class="grid gap-4 md:grid-cols-2">
    <LiveDemo client:only="react" tool="links" args={{ url: "{site}/" }} view="json" title="links() — the frontier from the home page" />
    <LiveDemo client:only="react" tool="card" args={{ url: "{site}/sitemap.xml" }} title="card() — the sitemap document" />
  </div>
  <h3 class="mt-10 mb-2 text-[16px] font-semibold">The crawl and the locate loop</h3>
  <Code code={CRAWL} />
  <p class="mt-3 text-[13px] text-muted">Watch one as it runs — every round, every decision, every Ask — in the Playground's Crawl workspace; the recorded rounds are in the <a class="text-accent" href="/features/traces">demo trace</a>.</p>
</Feature>

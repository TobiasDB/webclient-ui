---
import Feature from "../../layouts/Feature.astro";
import Code from "../../components/Code.astro";
import { TraceReplay } from "../../islands/TraceReplay";
import { PLAYGROUND_URL } from "../../lib/site";
const ONBOARD = `from webclient import WebClient
from webclient.pipelines import Brief, onboard_company

with WebClient() as wc:
    result = onboard_company(
        "Roasters", Brief(description="the case studies with their dates", fields=["title", "date"]),
        wc=wc, llm=my_model, search=my_search,       # your model + search -- or the stub, for a dry run
        interactive=True)                            # crawl -> select -> evaluate -> CONFIRM -> source -> query
    if result.pending:                               # the confirm gate: a human says yes, once
        result = result.resume("yes")
    open("case-studies.blob", "w").write(result.blob)   # tested; re-run forever without a model`;
---
<Feature slug="onboarding" next={["/features/plans", "/features/traces", "/cost"]}>
  <p class="mb-4 max-w-[820px] text-[15px] leading-7 text-muted">Onboarding is a pipeline of stages with gates: a brief in, a crawl to find the records, a selection, an evaluation, a confirm gate a human passes once, a source, and a query — out comes a plan blob that has been tested against the pages. What you see below is a <b>replay</b> of a recorded run (the demo model, badged), so nothing on this public page calls a model. Play it at your pace; every pane follows one clock.</p>
  <TraceReplay client:only="react" trace="onboarding" />
  <p class="mt-3 text-[13px] text-muted">Try it on your own data in the <a class="text-accent" href={`${PLAYGROUND_URL}/onboard`}>Playground's Onboard workspace</a> (configurable: your seed, your brief, your model or the stub).</p>
  <h3 class="mt-10 mb-2 text-[16px] font-semibold">In code</h3>
  <Code code={ONBOARD} />
</Feature>
